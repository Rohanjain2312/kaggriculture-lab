+def rival_supply_by(rival, product, until):
+    """How much of their pipeline for `product` reaches the market by day `until`."""
+    return sum(units for ready, units in rival.get(product, {}).items()
+               if ready <= until)
+
+
+def sale_horizon(crop, day):
+    """The day produce from planting `crop` today is finished arriving."""
+    c = CROPS[crop]
+    if c["ongoing"]:
+        units = sum(1 for k in range(c["max_yield"])
+                    if day + c["first_yield_day"] + k * c["interval"] <= LAST_DAY)
+        last = day + c["first_yield_day"] + max(0, units - 1) * c["interval"]
+    else:
+        last = day + c["max_yield_day"]
+    return min(LAST_DAY, last)
+
